	(footprint "handbrake:Pot_WH148_PanelMount"
		(layer "F.Cu")
		(uuid "ef5e698e-b798-4c56-9cf0-12c3cac7c083")
		(at 100 100)
		(descr "WH148 16 mm pot, panel-mounted: body on the BACK (bare) side, M7 bushing through a 7.5 mm hole, nut + washer on the copper side. Three 1.0 mm wire holes below the pot (handbrake board layout: GND, 3V3 inside the GND loop, W): short wires from the pot pins pass through from the back and are soldered on the copper side. Labels are silkscreen (documentation only; the board is milled).")
